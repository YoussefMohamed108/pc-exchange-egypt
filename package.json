{
  "name": "pc-exchange-egypt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:repository": "node scripts/check-repository.mjs",
    "test:e2e": "playwright test",
    "backend:up": "node scripts/backend.mjs up",
    "backend:status": "node scripts/backend.mjs status",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:share": "node scripts/backend.mjs share",
    "backend:migrate": "node scripts/backend.mjs migrate",
    "backend:autostart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 install",
    "backend:startup-status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 status",
    "backend:startup-disable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 disable",
    "backend:resume": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 resume",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.71.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
