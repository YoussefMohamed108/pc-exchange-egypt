# Copy to .env.local and replace with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep PC-hosted deployments clearly labeled as testing previews.
NEXT_PUBLIC_DEPLOYMENT_MODE=preview
NEXT_PUBLIC_AUTH_EMAIL_DELIVERY=local
# Optional separate FastAPI service; not needed for Phase 1.
PRICING_API_URL=http://localhost:8000
